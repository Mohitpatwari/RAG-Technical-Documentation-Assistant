# Required
GOOGLE_API_KEY=your_key_here
# Check the current Flash model name in Google AI Studio if you get a 404 "model not found"
LLM_MODEL=gemini-2.5-flash

# Optional
TAVILY_API_KEY=
ENABLE_HALLUCINATION_CHECK=false
MAX_RETRIES=2
RETRIEVAL_TOP_K=5
LLM_TIMEOUT=30
CORS_ORIGINS=http://localhost:3000,http://localhost:7860
